package com.isan.isan_flutter

import android.app.NotificationChannel
import android.app.NotificationManager
import android.content.Intent
import android.content.pm.PackageManager
import android.os.Build
import android.util.Log
import java.security.MessageDigest
import io.flutter.embedding.android.FlutterActivity
import io.flutter.embedding.engine.FlutterEngine
import io.flutter.plugin.common.MethodChannel

class MainActivity : FlutterActivity() {

    private val PLAYBACK_CHANNEL = "isan/playback"
    private var playbackChannel: MethodChannel? = null

    override fun onCreate(savedInstanceState: android.os.Bundle?) {
        super.onCreate(savedInstanceState)
        createFcmNotificationChannel()
    }

    /**
     * Channel notifikasi buat broadcast dari developer (FCM push, lihat
     * AndroidManifest.xml default_notification_channel_id). WAJIB dibuat
     * lewat NotificationManager dulu di Android 8+ -- kalau enggak, push
     * notification dari FCM gak akan kelihatan sama sekali walau berhasil
     * diterima device (silently dropped, gak ada error).
     */
    private fun createFcmNotificationChannel() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            val channel = NotificationChannel(
                "isan_broadcast_channel",
                "Pesan dari ISAN",
                NotificationManager.IMPORTANCE_HIGH
            )
            channel.description = "Notifikasi broadcast/pengumuman dari developer ISAN"
            val manager = getSystemService(NotificationManager::class.java)
            manager?.createNotificationChannel(channel)
        }
    }

    override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
        super.configureFlutterEngine(flutterEngine)
        Log.d("ISAN_NOTIF", "configureFlutterEngine called")

        // Daftarin custom WebView (BackgroundWebView) sebagai PlatformView,
        // dipakai dari Dart via AndroidView(viewType: "isan_background_webview").
        flutterEngine
            .platformViewsController
            .registry
            .registerViewFactory(
                "isan_background_webview",
                IsanWebViewFactory(flutterEngine.dartExecutor.binaryMessenger)
            )

        // Channel buat start/stop foreground service & update notifikasi,
        // plus nerima balik tap tombol prev/play-pause/next dari notifikasi.
        val channel = MethodChannel(flutterEngine.dartExecutor.binaryMessenger, PLAYBACK_CHANNEL)
        playbackChannel = channel
        channel.setMethodCallHandler { call, result ->
            when (call.method) {
                "start" -> {
                    startPlaybackService(null, null, true, null)
                    result.success(null)
                }
                "stop" -> {
                    stopService(Intent(this, PlaybackService::class.java))
                    result.success(null)
                }
                "update" -> {
                    val args = call.arguments as? Map<*, *>
                    val title = args?.get("title") as? String
                    val subtitle = args?.get("subtitle") as? String
                    val isPlaying = (args?.get("isPlaying") as? Boolean) ?: true
                    val artworkUrl = args?.get("artworkUrl") as? String
                    startPlaybackService(title, subtitle, isPlaying, artworkUrl)
                    result.success(null)
                }
                else -> result.notImplemented()
            }
        }

        PlaybackBridge.setListener { action ->
            Log.d("ISAN_NOTIF", "PlaybackBridge listener got action=$action, invoking on channel")
            runOnUiThread {
                playbackChannel?.invokeMethod(action, null)
                Log.d("ISAN_NOTIF", "invokeMethod($action) called on playbackChannel")
            }
        }

        // Channel buat tamper detection -- Dart minta hash sertifikat
        // signing APK ini sendiri, lalu dibandingkan ke hash yang
        // di-hardcode/dikirim dari backend. Kalau APK ini di-modif & di
        // re-sign pakai key lain (cara umum buat "crack" app Android),
        // hash-nya bakal beda dan Dart-side bisa memutuskan buat
        // mengunci/merusak fungsi app (lihat IntegrityGuard di Flutter).
        val integrityChannel = MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "isan/integrity")
        integrityChannel.setMethodCallHandler { call, result ->
            when (call.method) {
                "getSignatureSha256" -> {
                    result.success(getSignatureSha256())
                }
                else -> result.notImplemented()
            }
        }
    }

    /**
     * Ambil hash SHA-256 dari sertifikat signing APK yang sedang berjalan
     * SEKARANG di device ini. Kalau APK di-decompile, dimodif, lalu
     * di-repackage & di-sign ulang pakai keystore lain (debug keystore
     * default Android Studio, atau keystore bikinan sendiri), hash ini
     * PASTI berubah dibanding APK asli yang di-build & di-sign dari
     * keystore production milik developer -- karena setiap keystore
     * punya sertifikat unik.
     */
    private fun getSignatureSha256(): String {
        return try {
            val packageInfo = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
                packageManager.getPackageInfo(packageName, PackageManager.GET_SIGNING_CERTIFICATES)
            } else {
                @Suppress("DEPRECATION")
                packageManager.getPackageInfo(packageName, PackageManager.GET_SIGNATURES)
            }

            val signatures = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
                packageInfo.signingInfo?.apkContentsSigners
            } else {
                @Suppress("DEPRECATION")
                packageInfo.signatures
            }

            val signature = signatures?.firstOrNull() ?: return ""
            val md = MessageDigest.getInstance("SHA-256")
            val digest = md.digest(signature.toByteArray())
            digest.joinToString("") { "%02x".format(it) }
        } catch (e: Exception) {
            Log.e("ISAN_INTEGRITY", "Gagal ambil signature: ${e.message}")
            ""
        }
    }

    private fun startPlaybackService(title: String?, subtitle: String?, isPlaying: Boolean, artworkUrl: String?) {
        val intent = Intent(this, PlaybackService::class.java)
        intent.action = PlaybackService.ACTION_UPDATE
        if (title != null) intent.putExtra(PlaybackService.EXTRA_TITLE, title)
        if (subtitle != null) intent.putExtra(PlaybackService.EXTRA_SUBTITLE, subtitle)
        intent.putExtra(PlaybackService.EXTRA_IS_PLAYING, isPlaying)
        if (artworkUrl != null) intent.putExtra(PlaybackService.EXTRA_ARTWORK_URL, artworkUrl)
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            startForegroundService(intent)
        } else {
            startService(intent)
        }
    }

    override fun onDestroy() {
        // SENGAJA TIDAK panggil PlaybackBridge.setListener(null) di sini.
        // Kalau Android destroy Activity ini sementara app di background
        // (PlaybackService masih foreground & WebView/musik masih jalan),
        // listener yang null bikin tombol notifikasi (prev/pause/next)
        // berhenti berfungsi total -- padahal itu justru momen paling
        // penting buat tombol itu tetap jalan. Listener baru otomatis
        // ke-set ulang tiap kali configureFlutterEngine() dipanggil lagi
        // (Activity baru/recreate), jadi gak perlu di-null-kan manual di sini.
        super.onDestroy()
    }
}
