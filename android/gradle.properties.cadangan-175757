android.useAndroidX=true
android.enableJetifier=true
# This builtInKotlin flag was added automatically by Flutter migrator
android.builtInKotlin=false
# This newDsl flag was added automatically by Flutter migrator
android.newDsl=false


# ── BATAS MEMORI (ditambahkan supaya PC tidak kehabisan RAM) ──
# Mesin ini RAM-nya kecil, jadi tumpukan Gradle dipangkas.
org.gradle.jvmargs=-Xmx1200m -XX:MaxMetaspaceSize=384m -XX:+UseSerialGC
kotlin.daemon.jvmargs=-Xmx512m
# Tanpa daemon: tumpukan memori dilepas begitu build selesai.
org.gradle.daemon=false
# Satu pekerja saja supaya tidak ada beberapa tumpukan sekaligus.
org.gradle.workers.max=1
org.gradle.parallel=false
